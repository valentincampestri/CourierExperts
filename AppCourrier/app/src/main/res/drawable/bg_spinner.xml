<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Usar el color de fondo de la screen (soporta values-night) -->
    <solid android:color="@color/ce_bg_screen" />

    <!-- Borde gris (dejamos igual por ahora) -->
    <stroke
        android:width="1dp"
        android:color="@android:color/darker_gray" />

    <!-- Esquinas redondeadas usando dimensiones del proyecto -->
    <corners android:radius="@dimen/ce_radius_sm" />

    <!-- Un poco de padding interno -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
